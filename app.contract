// Exact Studio: record an area, a window, or a Simulator or Android emulator
// cropped to its bezel; then frame it on a background and edit it on a
// timeline (cuts, zooms in and out, speed, effects) and export. Capture,
// rendering, the preview and the timeline are the native module's
// (modules/apple/); this view lays them out and holds the frame's settings.
shape Status
  recording: bool
  name: string
  kind: string

shape Source
  id: string
  name: string
  app: string
  kind: string

shape SourceList
  items: Source[]
  allowed: bool

shape Recording
  id: string
  name: string
  kind: string
  created: number
  duration: number

shape RecordingList
  items: Recording[]

shape LookInfo
  background: string
  aspect: string
  padding: number
  radius: number
  shadow: bool
  cursor: bool
  cursorSize: number
  clickEffect: bool
  smoothCursor: bool
  customA: string
  customB: string
  customAngle: number
  customRadial: bool

shape SegmentInfo
  id: string
  kind: string
  level: number
  rate: number
  start: number
  end: number
  startText: string
  endText: string
  removed: bool
  first: bool
  last: bool
  transition: string
  text: string
  size: number
  color: string
  weight: string
  style: string
  animIn: string
  animOut: string
  loop: string
  rotation: number
  moveStyle: string
  duration: number
  scale: number
  tilt: number
  turn: number
  roll: number
  hasAngles: bool
  scope: string
  problem: string

shape Summary
  parts: number
  removed: number
  effects: number
  lanes: number
  moves: number
  length: number
  source: number
  playing: bool
  device: bool
  found: bool
  cursorDrawn: bool
  baseScale: number
  canUndoTemplate: bool
  threeOn: bool
  tilt: number
  turn: number
  roll: number
  angleMove: string
  thickness: number
  edge: string

shape Reply
  ok: bool
  error: string

shape Stopped
  ok: bool
  error: string
  id: string

shape Exported
  ok: bool
  error: string
  path: string

shape Done
  ok: bool

fn pad2(n: number): string = n < 10 ? `0${n}` : `${n}`
fn mmss(s: number): string = `${floor(s / 60)}:${pad2(floor(s) % 60)}`
fn kindSymbol(kind: string): string = kind == "simulator" or kind == "emulator" ? "symbol:sf/iphone" : kind == "display" ? "symbol:sf/display" : "symbol:sf/macwindow"
fn kindLabel(kind: string): string = kind == "simulator" ? "iOS Simulator" : kind == "emulator" ? "Android Emulator" : kind == "display" ? "Display" : "Window"
fn kindTitle(kind: string, level: number, rate: number): string = kind == "clip" ? "Clip Part" : kind == "move" ? "Move" : kind == "text" ? "Text" : kind == "3d" ? "3D Turn" : kind == "zoom" ? (level < 1 ? "Zoom Out" : "Zoom In") : kind == "speed" ? (rate < 1 ? "Slow Down" : "Speed Up") : kind == "spotlight" ? "Spotlight" : kind == "highlight" ? "Cursor Highlight" : kind == "blur" ? "Blur" : "Black & White"
fn effectLabel(kind: string): string = kind == "spotlight" ? "Spotlight" : kind == "highlight" ? "Cursor" : kind == "blur" ? "Blur" : "B&W"
fn isVisual(kind: string): bool = kind == "spotlight" or kind == "highlight" or kind == "blur" or kind == "mono"
fn poseLabel(p: string): string = p == "hero" ? "Hero" : p == "lean-left" ? "Lean Left" : p == "lean-right" ? "Lean Right" : p == "lay-back" ? "Lay Back" : p == "tumble" ? "Tumble" : "Face On"
fn countLine(n: number, one: string, many: string): string = n == 1 ? `1 ${one}` : `${n} ${many}`

routes nav
  home "/"

component ExactStudio
  state selected = ""
  state openPlace = true persist
  state openHelp = false persist
  state openBg = true persist
  state openFrame = true persist
  state openCursor = false persist
  state openDevice = true persist
  state open3d = true persist
  state startedAt = 0
  state now = 0
  state listed = 0
  state allWindows = false
  resource status = recorderStatus() as shape Status else empty()
  resource sources = captureSources(listed) as shape SourceList else empty()
  resource library = recordings() as shape RecordingList else empty()
  resource sel = editSelection(selected) as shape SegmentInfo else empty()
  resource summary = editSummary(selected) as shape Summary else empty()
  // The recording's own look (look.json beside it).
  resource lk = recordingLook(selected) as shape LookInfo else empty()
  mutation started as shape Reply then afterStart
  mutation stopped as shape Stopped refreshes library then afterStop
  mutation exported as shape Exported
  mutation deleted as shape Reply refreshes library
  mutation revealed as shape Done
  mutation nudged as shape Done refreshes library
  mutation edited as shape Done queue
  derive current = first(library.items.filter(r => r.id == selected))
  derive isDevice = summary.device or (match current { case some(r) => r.kind == "simulator" or r.kind == "emulator", case none => false })
  derive devices = sources.items.filter(s => s.kind == "simulator" or s.kind == "emulator")
  derive displays = sources.items.filter(s => s.kind == "display")
  derive windows = sources.items.filter(s => s.kind == "window")
  derive gradients = ["ocean", "sunset", "mint", "midnight", "graphite", "paper", "peach", "lagoon", "berry", "aurora", "ember", "lavender", "citrus", "forest", "sky", "rose", "dusk", "steel", "candy", "deepsea", "sand", "neon", "glow", "noir"]
  derive background = lk.background
  derive aspect = lk.aspect
  derive padding = lk.padding
  derive radius = lk.radius
  derive shadow = lk.shadow
  derive cursorOn = lk.cursor
  derive cursorSize = lk.cursorSize
  derive clickEffect = lk.clickEffect
  derive smoothCursor = lk.smoothCursor
  derive customA = lk.customA
  derive customB = lk.customB
  derive customAngle = lk.customAngle
  derive customRadial = lk.customRadial
  derive look = `{"background":"${background}","customA":"${customA}","customB":"${customB}","customAngle":${customAngle},"customRadial":${customRadial},"aspect":"${aspect}","padding":${padding},"radius":${radius},"shadow":${shadow},"cursor":${cursorOn},"cursorSize":${cursorSize / 100},"clickEffect":${clickEffect},"smoothCursor":${smoothCursor}}`
  derive startError = match started { case some(r) => r.error, case none => "" }
  derive stopError = match stopped { case some(r) => r.error, case none => "" }
  derive exportLine = match exported { case some(r) => (r.ok ? "Saved to Movies › Exact Studio." : r.error), case none => "" }
  derive exportPath = match exported { case some(r) => r.path, case none => "" }
  task tick when status.recording
    every(500, step)

  action step
    now = performanceNow()
  action refresh
    listed = listed + 1
  action toggleWindows
    allWindows = not allWindows
  action record(source: string)
    send started = startRecording(source)
  action afterStart
    startedAt = performanceNow()
    now = performanceNow()
  action stop
    send stopped = stopRecording()
  action afterStop
    match stopped
      case some(r)
        if r.ok
          selected = r.id
      case none
        selected = selected
  action choose(id: string)
    selected = id
  action pickBackground(v: string)
    send edited = editClip(selected, "look", "background", 0, v)
  action pickAspect(v: string)
    send edited = editClip(selected, "look", "aspect", 0, v)
  action setPadding(v: number)
    send edited = editClip(selected, "look", "padding", 0, `${round(v)}`)
  action setRadius(v: number)
    send edited = editClip(selected, "look", "radius", 0, `${round(v)}`)
  action setShadow(v: bool)
    send edited = editClip(selected, "look", "shadow", 0, `${v}`)
  action exportIt
    send exported = exportRecording(selected, look)
  action reveal
    send revealed = revealFile(exportPath)
  action remove
    send deleted = deleteRecording(selected)
    selected = ""
  action trim(edge: string, by: number)
    send nudged = nudgeCrop(selected, edge, by)
  action add(track: string)
    send edited = editClip(selected, "add", track, 0, "")
  action setNumber(n: number)
    send edited = editClip(selected, "set", "", n, "")
  action setKind(k: string)
    send edited = editClip(selected, "set", "", 0, k)
  action editDo(what: string)
    send edited = editClip(selected, what, "", 0, "")
  action toggleSection(name: string)
    if name == "place"
      openPlace = not openPlace
    if name == "help"
      openHelp = not openHelp
    if name == "bg"
      openBg = not openBg
    if name == "frame"
      openFrame = not openFrame
    if name == "cursor"
      openCursor = not openCursor
    if name == "device"
      openDevice = not openDevice
    if name == "3d"
      open3d = not open3d
  action setCustomA(v: string)
    send edited = editClip(selected, "look", "customA", 0, v)
  action setCustomB(v: string)
    send edited = editClip(selected, "look", "customB", 0, v)
  action setCustomAngle(v: number)
    send edited = editClip(selected, "look", "customAngle", 0, `${round(v)}`)
  action setCustomRadial(v: bool)
    send edited = editClip(selected, "look", "customRadial", 0, `${v}`)
  action swapCustom
    send edited = editClip(selected, "look", "swapCustom", 0, "")
  action setCursorOn(v: bool)
    send edited = editClip(selected, "look", "cursor", 0, `${v}`)
  action setCursorSize(v: number)
    send edited = editClip(selected, "look", "cursorSize", 0, `${round(v)}`)
  action setClickEffect(v: bool)
    send edited = editClip(selected, "look", "clickEffect", 0, `${v}`)
  action setSmoothCursor(v: bool)
    send edited = editClip(selected, "look", "smoothCursor", 0, `${v}`)
  action textField(field: string, v: string)
    send edited = editClip(selected, "text", field, 0, v)
  action textNumber(field: string, v: number)
    send edited = editClip(selected, "text", field, 0, `${round(v)}`)
  action moveField(field: string, v: string)
    send edited = editClip(selected, "move", field, 0, v)
  action moveNumber(field: string, v: number)
    send edited = editClip(selected, "move", field, 0, `${v}`)
  action threeField(field: string, v: string)
    send edited = editClip(selected, "three", field, 0, v)
  action threeNumber(field: string, v: number)
    send edited = editClip(selected, "three", field, 0, `${round(v)}`)
  action threeOn(v: bool)
    send edited = editClip(selected, "three", "on", 0, `${v}`)
  action segField(field: string, v: string)
    send edited = editClip(selected, "seg", field, 0, v)
  action segNumber(field: string, v: number)
    send edited = editClip(selected, "seg", field, 0, `${round(v)}`)
  action template(name: string)
    send edited = editClip(selected, "template", "", 0, name)
  action placeAt(name: string)
    send edited = editClip(selected, "place", "", 0, name)
  action pattern(name: string)
    send edited = editClip(selected, "pattern", "", 0, name)
  action setTransition(v: string)
    send edited = editClip(selected, "transition", "", 0, v)
  action setStart(v: string)
    send edited = editClip(selected, "start", "", 0, v)
  action setEnd(v: string)
    send edited = editClip(selected, "end", "", 0, v)

  view
    main testId="root" navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll="sidebar" position="absolute" inset=0 display="flex" flex-direction="column"
          header display="flex" align-items="center"
            text "Exact Studio" role="heading" aria-level=1 flex=1
          row flex=1 min-height=0
            // ── The sidebar: what to record, and what has been recorded.
            scroll id="sidebar" width="21rem" min-height=0 background-color="-exact-secondary-background"
              column gap=22 padding=16
                if status.recording
                  column gap=12 padding=16 border-radius=16 background-color="-exact-tertiary-background" testId="recording"
                    row gap=10 align-items="center"
                      column width=12 height=12 border-radius=6 background-color="-exact-system-red"
                      text "Recording" font="-exact-headline" flex=1
                      text mmss(max(0, (now - startedAt) / 1000)) font="-exact-title2" font-variant-numeric="tabular-nums" testId="elapsed"
                    text status.name font="-exact-footnote" color="-exact-secondary-label" line-clamp=2
                    button press=stop buttonStyle="filled" disabled=pending(stopped) testId="stop"
                      text "Stop Recording"
                    text "Or press Stop in the menu bar." font="-exact-caption1" color="-exact-tertiary-label"
                else
                  column gap=12 padding=16 border-radius=16 background-color="-exact-tertiary-background"
                    row gap=12 align-items="center"
                      column width=40 height=40 border-radius=20 background-color="-exact-system-red" align-items="center" justify-content="center"
                        image "symbol:sf/record.circle" color="white" font="-exact-title3" aria-hidden=true
                      column flex=1 min-width=0
                        text "New Recording" font="-exact-headline"
                        text "Pick what to capture" font="-exact-footnote" color="-exact-secondary-label"
                    button press=record("area") buttonStyle="filled" disabled=pending(started) testId="record-area"
                      image "symbol:sf/rectangle.dashed"
                      text "Drag Out an Area"
                    if not sources.allowed and not pending(sources)
                      text "Allow Exact Studio in System Settings › Privacy & Security › Screen & System Audio Recording, then reopen the app." font="-exact-footnote" color="-exact-system-orange" testId="permission"
                    if startError != "" and not pending(started)
                      text startError font="-exact-footnote" color="-exact-system-red" testId="start-error"
                  if devices.length > 0
                    column gap=6
                      text "SIMULATORS" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6
                      for s in devices key=s.id
                        button press=record(s.id) disabled=pending(started) testId=`source-${s.id}` appearance="none" justify-content="flex-start" padding=10 border-radius=12 background-color="-exact-tertiary-background"
                          row gap=10 align-items="center" min-width=0 flex=1
                            column width=34 height=34 border-radius=9 background-color="-exact-system-blue" align-items="center" justify-content="center"
                              image "symbol:sf/iphone" color="white" aria-hidden=true
                            column min-width=0 flex=1 align-items="flex-start"
                              text s.name line-clamp=1 font-weight=500 text-align="left" align-self="stretch"
                              text `${s.app} · fits the bezel` font="-exact-caption1" color="-exact-system-teal" line-clamp=1
                            image "symbol:sf/record.circle" color="-exact-system-red" aria-hidden=true
                  column gap=4
                    row align-items="center"
                      text "DISPLAYS" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6 flex=1
                      button press=refresh aria-label="Refresh sources" testId="refresh"
                        image "symbol:refresh"
                    for s in displays key=s.id
                      button press=record(s.id) disabled=pending(started) testId=`source-${s.id}` appearance="none" justify-content="flex-start" padding=8 border-radius=10
                        row gap=10 align-items="center" min-width=0 flex=1
                          image "symbol:sf/display" color="-exact-secondary-label" aria-hidden=true
                          text s.name line-clamp=1 flex=1 text-align="left"
                  column gap=4
                    row align-items="center"
                      text "WINDOWS" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6 flex=1
                      if windows.length > 6
                        button press=toggleWindows testId="all-windows"
                          text (allWindows ? "Fewer" : `All ${windows.length}`) font="-exact-caption1"
                    for s in (allWindows ? windows : windows.slice(0, 6)) key=s.id
                      button press=record(s.id) disabled=pending(started) testId=`source-${s.id}` appearance="none" justify-content="flex-start" padding=8 border-radius=10
                        row gap=10 align-items="center" min-width=0 flex=1
                          image "symbol:sf/macwindow" color="-exact-secondary-label" aria-hidden=true
                          column min-width=0 flex=1 align-items="flex-start"
                            text s.name line-clamp=1 text-align="left" align-self="stretch"
                            text s.app font="-exact-caption2" color="-exact-tertiary-label" line-clamp=1 text-align="left" align-self="stretch"
                column gap=6
                  text "LIBRARY" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6
                  if stopError != "" and not pending(stopped)
                    text stopError font="-exact-footnote" color="-exact-system-red" testId="stop-error"
                  if library.items.length == 0
                    text "Nothing recorded yet." color="-exact-tertiary-label" testId="no-recordings"
                  for r in library.items key=r.id
                    button press=choose(r.id) aria-pressed=(r.id == selected) testId=`recording-${r.id}` appearance="none" justify-content="flex-start" padding=10 border-radius=12 background-color=(r.id == selected ? "-exact-tertiary-background" : "transparent")
                      row gap=10 align-items="center" min-width=0 flex=1
                        column width=34 height=34 border-radius=9 background-color=(r.id == selected ? "-exact-system-blue" : "-exact-tertiary-fill") align-items="center" justify-content="center"
                          image kindSymbol(r.kind) color=(r.id == selected ? "white" : "-exact-secondary-label") aria-hidden=true
                        column min-width=0 flex=1 align-items="flex-start"
                          text r.name line-clamp=1 font-weight=(r.id == selected ? 600 : 400) text-align="left" align-self="stretch"
                          text `${kindLabel(r.kind)} · ${mmss(r.duration)}` font="-exact-caption1" color="-exact-secondary-label" font-variant-numeric="tabular-nums" text-align="left" align-self="stretch"

            // ── The stage: the framed preview, the edit bar and the timeline.
            match current
              case none
                column flex=1 min-width=0 align-items="center" justify-content="center" gap=10 padding=40 background-color="-exact-background" testId="empty"
                  column width=72 height=72 border-radius=20 background-color="-exact-tertiary-background" align-items="center" justify-content="center"
                    image "symbol:sf/rectangle.dashed.badge.record" font="-exact-large-title" color="-exact-secondary-label" aria-hidden=true
                  text "Record something to start" font="-exact-title2" font-weight=600
                  text "Drag out an area, or pick a window or a device in the sidebar. A Simulator or an emulator is cropped to its bezel, nothing more." color="-exact-secondary-label" text-align="center" max-width="28rem"
              case some(rec)
                column flex=1 min-width=0 min-height=0 gap=12 padding=16 background-color="-exact-background"
                  studio-preview clip=rec.id look=look aria-label="Preview" flex=1 min-height=200 testId="preview"
                  row gap=8 align-items="center" flex-wrap="wrap"
                    button press=editDo("play") aria-label=(summary.playing ? "Pause" : "Play") buttonStyle="filled" testId="play"
                      image (summary.playing ? "symbol:pause-fill" : "symbol:play-fill")
                    column width=1 height=22 background-color="-exact-separator"
                    button popovertarget="add-menu" buttonStyle="bordered" testId="add"
                      image "symbol:add"
                      text "Add"
                    column id="add-menu" popover="auto" role="menu" aria-label="Add at the playhead"
                      button press=add("text") popovertarget="add-menu" popovertargetaction="hide" testId="add-text"
                        image "symbol:sf/textformat"
                        text "Text"
                      hr
                      button press=add("zoom-in") popovertarget="add-menu" popovertargetaction="hide" testId="add-zoom-in"
                        image "symbol:sf/plus.magnifyingglass"
                        text "Zoom In"
                      button press=add("zoom-out") popovertarget="add-menu" popovertargetaction="hide" testId="add-zoom-out"
                        image "symbol:sf/minus.magnifyingglass"
                        text "Zoom Out"
                      hr
                      button press=add("slow") popovertarget="add-menu" popovertargetaction="hide" testId="add-slow"
                        image "symbol:sf/tortoise"
                        text "Slow Down"
                      button press=add("fast") popovertarget="add-menu" popovertargetaction="hide" testId="add-fast"
                        image "symbol:sf/hare"
                        text "Speed Up"
                      hr
                      button press=add("spotlight") popovertarget="add-menu" popovertargetaction="hide" testId="add-spotlight"
                        image "symbol:sf/flashlight.on.fill"
                        text "Spotlight"
                      button press=add("highlight") popovertarget="add-menu" popovertargetaction="hide" testId="add-highlight"
                        image "symbol:sf/cursorarrow.rays"
                        text "Cursor Highlight"
                      button press=add("blur") popovertarget="add-menu" popovertargetaction="hide" testId="add-blur"
                        image "symbol:sf/drop"
                        text "Blur"
                      button press=add("mono") popovertarget="add-menu" popovertargetaction="hide" testId="add-mono"
                        image "symbol:sf/circle.lefthalf.filled"
                        text "Black & White"
                      hr
                      button press=add("3d") popovertarget="add-menu" popovertargetaction="hide" testId="add-3d"
                        image "symbol:sf/rotate.3d"
                        text "3D Turn"
                        text "Turns in 3D for a while, then back"
                    column width=1 height=22 background-color="-exact-separator"
                    button press=editDo("split-clip") buttonStyle="bordered" testId="split-clip"
                      image "symbol:sf/scissors"
                      text "Split Clip"
                    button popovertarget="motion-menu" buttonStyle="bordered" testId="motion"
                      image "symbol:sf/arrow.up.and.down.and.arrow.left.and.right"
                      text "Motion"
                    column id="motion-menu" popover="auto" role="menu" aria-label="Animate the video's place"
                      button press=editDo("add-move") popovertarget="motion-menu" popovertargetaction="hide" testId="add-move"
                        image "symbol:sf/diamond"
                        text "Add Move Here"
                        text "Then drag the video where it should go"
                      hr
                      button press=pattern("side") popovertarget="motion-menu" popovertargetaction="hide" testId="pattern-side"
                        text "Side to Side"
                        text "Left, right, back to the middle"
                      button press=pattern("tour") popovertarget="motion-menu" popovertargetaction="hide" testId="pattern-tour"
                        text "Zoom Tour"
                        text "Through full screen to each side"
                      button press=pattern("entrance") popovertarget="motion-menu" popovertargetaction="hide" testId="pattern-entrance"
                        text "Entrance"
                        text "Springs in from below"
                      button press=pattern("bounce") popovertarget="motion-menu" popovertargetaction="hide" testId="pattern-bounce"
                        text "Bounce"
                        text "Pops from side to side"
                      button press=pattern("drift") popovertarget="motion-menu" popovertargetaction="hide" testId="pattern-drift"
                        text "Slow Push In"
                        text "A gentle zoom over six seconds"
                      hr
                      button press=pattern("turntable") popovertarget="motion-menu" popovertargetaction="hide" testId="pattern-turntable"
                        text "3D Turntable"
                        text "Swings to each side, then faces front"
                      button press=pattern("orbit") popovertarget="motion-menu" popovertargetaction="hide" testId="pattern-orbit"
                        text "3D Orbit"
                        text "One full turn around"
                      button press=pattern("reveal") popovertarget="motion-menu" popovertargetaction="hide" testId="pattern-reveal"
                        text "3D Hero Reveal"
                        text "Rises from lying back into a hero angle"
                      button press=pattern("flip") popovertarget="motion-menu" popovertargetaction="hide" testId="pattern-flip"
                        text "3D Flip In"
                        text "Turns in from edge-on with a spring"
                      button press=pattern("float") popovertarget="motion-menu" popovertargetaction="hide" testId="pattern-float"
                        text "3D Float"
                        text "Drifts between gentle angles"
                    button popovertarget="template-menu" buttonStyle="bordered" testId="templates"
                      image "symbol:sf/wand.and.stars"
                      text "Templates"
                    column id="template-menu" popover="auto" role="menu" aria-label="Templates: replace the texts, effects and moves"
                      button press=template("launch") popovertarget="template-menu" popovertargetaction="hide" testId="template-launch"
                        text "Clean Launch"
                        text "Blurred title card, zooms on clicks, an end line"
                      button press=template("hero") popovertarget="template-menu" popovertargetaction="hide" testId="template-hero"
                        text "Product Hero"
                        text "A 3D hero angle, a feature line, an orbit"
                      button press=template("tour") popovertarget="template-menu" popovertargetaction="hide" testId="template-tour"
                        text "Feature Tour"
                        text "Three captions, moving between sides"
                      button press=template("teaser") popovertarget="template-menu" popovertargetaction="hide" testId="template-teaser"
                        text "Social Teaser"
                        text "A blurred hook, pops, a 3D tumble, a call to action"
                      if summary.canUndoTemplate
                        hr
                        button press=editDo("undo-template") popovertarget="template-menu" popovertargetaction="hide" testId="template-undo"
                          text "Undo Template"
                    button press=editDo("auto") buttonStyle="bordered" testId="auto-zoom"
                      image "symbol:sf/cursorarrow.click.2"
                      text "Zoom on Clicks"
                    text `Video ${mmss(summary.length)} · recorded ${mmss(summary.source)}` flex=1 text-align="right" font-variant-numeric="tabular-nums" color="-exact-secondary-label" testId="length"
                  studio-timeline clip=rec.id aria-label="Timeline" testId="timeline"

            // ── The inspector: the selected segment, the frame, export.
            if current != none
              scroll width="22rem" min-height=0 background-color="-exact-secondary-background"
                column gap=20 padding=16
                  column gap=8
                    button press=exportIt buttonStyle="filled" disabled=pending(exported) testId="export"
                      image "symbol:sf/square.and.arrow.up"
                      text (pending(exported) ? "Exporting…" : "Export MP4")
                    if exportLine != ""
                      row gap=8 align-items="center"
                        text exportLine font="-exact-footnote" color="-exact-secondary-label" flex=1 testId="export-line"
                        if exportPath != ""
                          button press=reveal testId="reveal"
                            text "Show" font="-exact-footnote"

                  if sel.problem != ""
                    row gap=8 padding=12 border-radius=12 background-color="-exact-tertiary-background" align-items="flex-start" testId="problem"
                      image "symbol:alert" color="-exact-system-orange" aria-hidden=true
                      text sel.problem font="-exact-footnote" flex=1
                  if sel.id != ""
                    column gap=12 padding=14 border-radius=14 background-color="-exact-tertiary-background" testId="segment"
                      row align-items="center" gap=8
                        text kindTitle(sel.kind, sel.level, sel.rate) font="-exact-headline" flex=1 testId="segment-title"
                        if sel.kind == "clip" and sel.removed
                          text "Removed" font="-exact-footnote" color="-exact-system-red"
                      row gap=8
                        column gap=4 flex=1 min-width=0
                          text "Start" font="-exact-caption1" color="-exact-secondary-label"
                          input value=sel.startText change=setStart disabled=(sel.kind == "clip" and sel.first) aria-label="Start" font-variant-numeric="tabular-nums" testId="start"
                        column gap=4 flex=1 min-width=0
                          text "End" font="-exact-caption1" color="-exact-secondary-label"
                          input value=sel.endText change=setEnd disabled=(sel.kind == "clip" and sel.last) aria-label="End" font-variant-numeric="tabular-nums" testId="end"
                      text "Type a time like 1.25 or 0:01.25 and press Return." font="-exact-caption1" color="-exact-tertiary-label"
                      if sel.kind == "zoom"
                        text "Zoom in" font="-exact-caption1" color="-exact-secondary-label"
                        row role="radiogroup" aria-label="Zoom in"
                          for z in [1.5, 2, 2.5, 3] key=z
                            button role="radio" aria-checked=(sel.level == z) press=setNumber(z) testId=`level-${z}` flex=1
                              text `${z}×`
                        text "Zoom out" font="-exact-caption1" color="-exact-secondary-label"
                        row role="radiogroup" aria-label="Zoom out"
                          for z in [0.5, 0.7, 0.85] key=z
                            button role="radio" aria-checked=(sel.level == z) press=setNumber(z) testId=`level-${z}` flex=1
                              text `${z}×`
                      if sel.kind == "speed"
                        text "Slow down" font="-exact-caption1" color="-exact-secondary-label"
                        row role="radiogroup" aria-label="Slow down"
                          for r in [0.25, 0.5, 0.75] key=r
                            button role="radio" aria-checked=(sel.rate == r) press=setNumber(r) testId=`rate-${r}` flex=1
                              text `${r}×`
                        text "Speed up" font="-exact-caption1" color="-exact-secondary-label"
                        row role="radiogroup" aria-label="Speed up"
                          for r in [1.5, 2, 4, 8] key=r
                            button role="radio" aria-checked=(sel.rate == r) press=setNumber(r) testId=`rate-${r}` flex=1
                              text `${r}×`
                      if isVisual(sel.kind)
                        row align-items="center" gap=8
                          text "Effect" flex=1
                          select value=sel.kind change=setKind aria-label="Effect" testId="effect-kind"
                            option "Spotlight" value="spotlight"
                            option "Cursor highlight" value="highlight"
                            option "Blur" value="blur"
                            option "Black & white" value="mono"
                        if sel.kind == "blur" or sel.kind == "mono"
                          text "Covers" font="-exact-caption1" color="-exact-secondary-label"
                          row role="radiogroup" aria-label="Covers"
                            button role="radio" aria-checked=(sel.scope != "frame") press=segField("scope", "video") flex=1 testId="scope-video"
                              text "Video"
                            button role="radio" aria-checked=(sel.scope == "frame") press=segField("scope", "frame") flex=1 testId="scope-frame"
                              text "Whole Frame"
                      if sel.kind == "3d"
                        text "Turns in 3D over its span and back, even with Show in 3D off." font="-exact-caption1" color="-exact-tertiary-label"
                        row role="radiogroup" aria-label="Turn style"
                          button role="radio" aria-checked=(sel.style != "orbit") press=segField("style", "hold") flex=1 testId="turn-hold"
                            text "Hold a Pose"
                          button role="radio" aria-checked=(sel.style == "orbit") press=segField("style", "orbit") flex=1 testId="turn-orbit"
                            text "Full Orbit"
                        row gap=6 flex-wrap="wrap"
                          for p in ["hero", "lean-left", "lean-right", "lay-back", "tumble"] key=p
                            button press=segField("pose", p) buttonStyle="bordered" testId=`turn-${p}`
                              text poseLabel(p)
                        column gap=4
                          row
                            text "Tilt" flex=1
                            text `${sel.tilt}°` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=-80 max=80 step=1 value=sel.tilt change=segNumber("tilt") aria-label="Tilt" testId="turn-tilt"
                        column gap=4
                          row
                            text "Turn" flex=1
                            text `${sel.turn}°` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=-80 max=80 step=1 value=sel.turn change=segNumber("turn") aria-label="Turn" testId="turn-turn"
                      if sel.kind == "text"
                        column gap=4
                          text "Words" font="-exact-caption1" color="-exact-secondary-label"
                          input value=sel.text change=textField("text") aria-label="Text" testId="text-words"
                        column gap=4
                          row
                            text "Size" flex=1
                            text `${round(sel.size)}` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=2 max=30 step=0.5 value=sel.size change=textNumber("size") aria-label="Text size" testId="text-size"
                        column gap=4
                          row
                            text "Tilt" flex=1
                            text `${sel.rotation}°` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=-45 max=45 step=1 value=sel.rotation change=textNumber("rotation") aria-label="Tilt" testId="text-rotation"
                        row gap=6 role="radiogroup" aria-label="Colour" appearance="none"
                          for c in ["white", "black", "yellow", "pink", "blue", "mint"] key=c
                            button role="radio" aria-checked=(sel.color == c) aria-label=c press=textField("color", c) testId=`text-color-${c}` width=26 height=26 border-radius=13 border-width=2 border-style="solid" border-color=(sel.color == c ? "-exact-system-blue" : "-exact-separator") background-color=(c == "white" ? "#ffffff" : c == "black" ? "#111111" : c == "yellow" ? "#ffd633" : c == "pink" ? "#ff458c" : c == "blue" ? "#408cff" : "#59ebb3")
                        row role="radiogroup" aria-label="Weight"
                          for w in ["regular", "bold", "heavy", "rounded"] key=w
                            button role="radio" aria-checked=(sel.weight == w) press=textField("weight", w) testId=`text-weight-${w}` flex=1
                              text (w == "regular" ? "Light" : w == "bold" ? "Bold" : w == "heavy" ? "Heavy" : "Round")
                        row align-items="center" gap=8
                          text "Shape" flex=1
                          select value=sel.style change=textField("style") aria-label="Shape" testId="text-style"
                            option "Plain" value="plain"
                            option "Pill" value="pill"
                            option "Box" value="box"
                            option "Outline" value="outline"
                            option "Soft shadow" value="shadow"
                        row align-items="center" gap=8
                          text "In" flex=1
                          select value=sel.animIn change=textField("in") aria-label="Animation in" testId="text-in"
                            option "Letters spring up" value="letters"
                            option "Letters pop" value="letters-pop"
                            option "Letters drop" value="drop"
                            option "Typewriter" value="typewriter"
                            option "Pop" value="pop"
                            option "Spin in" value="spin"
                            option "Slide in" value="slide"
                            option "Rise" value="rise"
                            option "Blur in" value="blur"
                            option "Fade" value="fade"
                            option "None" value="none"
                        row align-items="center" gap=8
                          text "Out" flex=1
                          select value=sel.animOut change=textField("out") aria-label="Animation out" testId="text-out"
                            option "Fade" value="fade"
                            option "Letters fall" value="fall"
                            option "Letters fade" value="letters"
                            option "Pop away" value="pop"
                            option "Sink" value="sink"
                            option "Blur out" value="blur"
                            option "None" value="none"
                        row align-items="center" gap=8
                          text "While shown" flex=1
                          select value=sel.loop change=textField("loop") aria-label="While shown" testId="text-loop"
                            option "Still" value="none"
                            option "Wave" value="wave"
                            option "Pulse" value="pulse"
                            option "Float" value="float"
                            option "Wiggle" value="wiggle"
                        text "Drag the text in the preview to place it; scroll over it to resize." font="-exact-caption1" color="-exact-tertiary-label"
                      if sel.kind == "move"
                        text "Where it lands" font="-exact-caption1" color="-exact-secondary-label"
                        row gap=6 flex-wrap="wrap"
                          for pl in ["center", "left", "right", "top", "bottom", "large", "small"] key=pl
                            button press=placeAt(pl) buttonStyle="bordered" testId=`move-place-${pl}`
                              text (pl == "center" ? "Center" : pl == "left" ? "Left" : pl == "right" ? "Right" : pl == "top" ? "Top" : pl == "bottom" ? "Bottom" : pl == "large" ? "Large" : "Corner")
                        row align-items="center" gap=8
                          text "Style" flex=1
                          select value=sel.moveStyle change=moveField("style") aria-label="Move style" testId="move-style"
                            option "Smooth" value="smooth"
                            option "Linear" value="linear"
                            option "Spring" value="spring"
                            option "Zoom through" value="zoom"
                            option "Swipe" value="swipe"
                            option "Fade" value="fade"
                            option "Spin" value="spin"
                            option "Pop" value="pop"
                        text "Speed" font="-exact-caption1" color="-exact-secondary-label"
                        row role="radiogroup" aria-label="Speed"
                          for d in [0.4, 0.8, 1.4, 2.5] key=d
                            button role="radio" aria-checked=(sel.duration == d) press=moveNumber("duration", d) testId=`move-speed-${d}` flex=1
                              text (d == 0.4 ? "Fast" : d == 0.8 ? "Normal" : d == 1.4 ? "Slow" : "Calm")
                        column gap=4
                          row
                            text "Size" flex=1
                            text `${sel.scale}%` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=20 max=250 step=1 value=sel.scale change=moveNumber("scale") aria-label="Size" testId="move-scale"
                        text (sel.hasAngles ? "3D angle it lands at" : "3D angle (keeps the one before)") font="-exact-caption1" color="-exact-secondary-label"
                        row gap=6 flex-wrap="wrap"
                          for p in ["hero", "lean-left", "lean-right", "lay-back", "tumble", "face"] key=p
                            button press=threeField("preset", p) buttonStyle="bordered" testId=`move-three-${p}`
                              text poseLabel(p)
                        column gap=4
                          row
                            text "Tilt" flex=1
                            text `${sel.tilt}°` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=-80 max=80 step=1 value=sel.tilt change=threeNumber("tilt") aria-label="Tilt" testId="move-tilt"
                        column gap=4
                          row
                            text "Turn" flex=1
                            text `${sel.turn}°` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=-80 max=80 step=1 value=sel.turn change=threeNumber("turn") aria-label="Turn" testId="move-turn"
                        column gap=4
                          row
                            text "Roll" flex=1
                            text `${sel.roll}°` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=-45 max=45 step=1 value=sel.roll change=threeNumber("roll") aria-label="Roll" testId="move-roll"
                        text "With this move selected, drag the video in the preview to set where it lands, and ⌥-drag to set its 3D angle. Spin turns it a full circle in 3D." font="-exact-caption1" color="-exact-tertiary-label"
                      if sel.kind == "clip"
                        button press=editDo("remove") buttonStyle=(sel.removed ? "bordered" : "filled") testId="piece-remove"
                          text (sel.removed ? "Restore This Part" : "Remove This Part")
                        row gap=8
                          button press=editDo("join-prev") buttonStyle="bordered" flex=1 disabled=sel.first testId="join-prev"
                            text "Join Previous"
                          button press=editDo("join-next") buttonStyle="bordered" flex=1 disabled=sel.last testId="join-next"
                            text "Join Next"
                        if not sel.removed and not sel.last
                          row align-items="center" gap=8
                            text "Into the next part" flex=1
                            select value=sel.transition change=setTransition aria-label="Transition" testId="transition"
                              option "Cut" value="cut"
                              option "Crossfade" value="crossfade"
                              option "Fade through" value="fade"
                          text "Used where removed parts lie between this part and the next." font="-exact-caption1" color="-exact-tertiary-label"
                      else
                        row gap=8
                          if sel.kind != "move"
                            button press=editDo("split") buttonStyle="bordered" flex=1 testId="segment-split"
                              text "Split Here"
                          button press=editDo("delete") buttonStyle="bordered" flex=1 testId="segment-delete"
                            text "Remove"
                  else
                    column gap=10
                      button press=toggleSection("place") appearance="none" aria-expanded=openPlace testId="sec-place" padding-top=2 padding-bottom=2
                        row align-items="center" gap=6 flex=1
                          text "PLACEMENT" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6 flex=1 text-align="left"
                          image (openPlace ? "symbol:sf/chevron.down" : "symbol:sf/chevron.right") font="-exact-caption1" color="-exact-tertiary-label" aria-hidden=true
                      if openPlace
                        row gap=6 flex-wrap="wrap"
                          for pl in ["center", "left", "right", "top", "bottom", "large", "small"] key=pl
                            button press=placeAt(pl) buttonStyle="bordered" testId=`place-${pl}`
                              text (pl == "center" ? "Center" : pl == "left" ? "Left" : pl == "right" ? "Right" : pl == "top" ? "Top" : pl == "bottom" ? "Bottom" : pl == "large" ? "Large" : "Corner")
                        text (summary.moves == 0 ? "Drag the video in the preview, or scroll over it to resize. With no moves this places it for the whole video." : "Placing at the playhead adds a move there. Motion › Add Move Here, then drag, animates it.") font="-exact-caption1" color="-exact-tertiary-label"
                    column gap=10
                      button press=toggleSection("help") appearance="none" aria-expanded=openHelp testId="sec-help" padding-top=2 padding-bottom=2
                        row align-items="center" gap=6 flex=1
                          text "TIMELINE" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6 flex=1 text-align="left"
                          image (openHelp ? "symbol:sf/chevron.down" : "symbol:sf/chevron.right") font="-exact-caption1" color="-exact-tertiary-label" aria-hidden=true
                      text `${countLine(summary.parts, "clip part", "clip parts")} (${summary.removed} removed) · ${countLine(summary.effects, "effect", "effects")} on ${countLine(summary.lanes, "lane", "lanes")} · ${countLine(summary.moves, "move", "moves")}` font="-exact-footnote" color="-exact-secondary-label" testId="summary"
                      if openHelp
                        text "To cut, put the playhead where a cut should go and press Split Clip (or S). Then select a part of the clip and remove it. Add effects at the playhead with Add. They can overlap on separate lanes, except two zooms, two speed changes, or two of the same effect. Delete removes the selection; Space plays." font="-exact-footnote" color="-exact-tertiary-label"

                  column gap=12
                    button press=toggleSection("bg") appearance="none" aria-expanded=openBg testId="sec-bg" padding-top=2 padding-bottom=2
                      row align-items="center" gap=6 flex=1
                        text "BACKGROUND" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6 flex=1 text-align="left"
                        image (openBg ? "symbol:sf/chevron.down" : "symbol:sf/chevron.right") font="-exact-caption1" color="-exact-tertiary-label" aria-hidden=true
                    if openBg
                      row gap=8 flex-wrap="wrap" role="radiogroup" aria-label="Background" appearance="none"
                        for b in gradients key=b
                          button role="radio" aria-checked=(background == b) aria-label=b press=pickBackground(b) testId=`bg-${b}` padding=3 border-radius=13 border-width=2 border-style="solid" border-color=(background == b ? "-exact-system-blue" : "transparent")
                            image `assets/swatches/${b}.png` width=34 height=34 border-radius=10 aria-hidden=true
                      row gap=8
                        button press=pickBackground("video") buttonStyle=(background == "video" ? "filled" : "bordered") flex=1 testId="bg-video"
                          image "symbol:sf/drop.halffull"
                          text "Blurred Video"
                        button press=pickBackground("custom") buttonStyle=(background == "custom" ? "filled" : "bordered") flex=1 testId="bg-custom"
                          image "symbol:sf/paintpalette"
                          text "Custom"
                      if background == "custom"
                        column gap=10 padding=12 border-radius=12 background-color="-exact-tertiary-background"
                          row align-items="center" gap=10
                            text "From" flex=1
                            studio-color hex=customA change=setCustomA aria-label="Gradient start colour" width=64 height=28 testId="custom-a"
                          row align-items="center" gap=10
                            text "To" flex=1
                            studio-color hex=customB change=setCustomB aria-label="Gradient end colour" width=64 height=28 testId="custom-b"
                          row role="radiogroup" aria-label="Gradient kind"
                            button role="radio" aria-checked=(not customRadial) press=setCustomRadial(false) flex=1 testId="custom-linear"
                              text "Linear"
                            button role="radio" aria-checked=customRadial press=setCustomRadial(true) flex=1 testId="custom-radial"
                              text "Radial"
                          if not customRadial
                            column gap=4
                              row
                                text "Direction" flex=1
                                text `${customAngle}°` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                              input type="range" min=0 max=360 step=5 value=customAngle input=setCustomAngle aria-label="Gradient direction" testId="custom-angle"
                          button press=swapCustom testId="custom-swap"
                            text "Swap Colours" font="-exact-footnote"

                  column gap=12
                    button press=toggleSection("frame") appearance="none" aria-expanded=openFrame testId="sec-frame" padding-top=2 padding-bottom=2
                      row align-items="center" gap=6 flex=1
                        text "FRAME" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6 flex=1 text-align="left"
                        image (openFrame ? "symbol:sf/chevron.down" : "symbol:sf/chevron.right") font="-exact-caption1" color="-exact-tertiary-label" aria-hidden=true
                    if openFrame
                      row role="radiogroup" aria-label="Shape"
                        for a in ["16:9", "9:16", "1:1", "4:3", "auto"] key=a
                          button role="radio" aria-checked=(aspect == a) press=pickAspect(a) testId=`aspect-${a}` flex=1
                            text (a == "auto" ? "Fit" : a)
                      column gap=4
                        row
                          text "Padding" flex=1
                          text `${padding}%` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                        input type="range" min=0 max=30 step=1 value=padding input=setPadding aria-label="Padding" testId="padding"
                      if not isDevice
                        column gap=4
                          row
                            text "Corners" flex=1
                            text `${radius}` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=0 max=48 step=1 value=radius input=setRadius aria-label="Corner radius" testId="radius"
                      row align-items="center"
                        text "Shadow" flex=1
                        input type="checkbox" switch checked=shadow change=setShadow aria-label="Shadow" testId="shadow"

                  column gap=10
                    button press=toggleSection("3d") appearance="none" aria-expanded=open3d testId="sec-3d" padding-top=2 padding-bottom=2
                      row align-items="center" gap=6 flex=1
                        text "3D" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6 flex=1 text-align="left"
                        image (open3d ? "symbol:sf/chevron.down" : "symbol:sf/chevron.right") font="-exact-caption1" color="-exact-tertiary-label" aria-hidden=true
                    if open3d
                      row align-items="center"
                        text "Show in 3D" flex=1
                        input type="checkbox" switch checked=summary.threeOn change=threeOn aria-label="Show in 3D" testId="three-on"
                      row gap=6 flex-wrap="wrap"
                        for p in ["hero", "lean-left", "lean-right", "lay-back", "tumble", "face"] key=p
                          button press=threeField("preset", p) buttonStyle=(summary.threeOn and p == "face" and summary.tilt == 0 and summary.turn == 0 ? "filled" : "bordered") testId=`three-${p}`
                            text poseLabel(p)
                      if summary.threeOn
                        column gap=4
                          row
                            text "Tilt" flex=1
                            text `${summary.tilt}°` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=-80 max=80 step=1 value=summary.tilt input=threeNumber("tilt") aria-label="Tilt" testId="three-tilt"
                        column gap=4
                          row
                            text "Turn" flex=1
                            text `${summary.turn}°` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=-80 max=80 step=1 value=summary.turn input=threeNumber("turn") aria-label="Turn" testId="three-turn"
                        column gap=4
                          row
                            text "Roll" flex=1
                            text `${summary.roll}°` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=-45 max=45 step=1 value=summary.roll input=threeNumber("roll") aria-label="Roll" testId="three-roll"
                        column gap=4
                          row
                            text "Thickness" flex=1
                            text `${summary.thickness}%` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          input type="range" min=1 max=15 step=0.5 value=summary.thickness change=threeNumber("thickness") aria-label="Thickness" testId="three-thickness"
                        row align-items="center" gap=8
                          text "Edge" flex=1
                          select value=summary.edge change=threeField("edge") aria-label="Edge" testId="three-edge"
                            option "Polished metal" value="metal"
                            option "Aluminum" value="aluminum"
                            option "Glass" value="glass"
                            option "Matte" value="matte"
                      text (summary.angleMove != "" ? `Angle and pose edit the move at ${summary.angleMove}, which sets the angle here. ⌥-drag the video to turn it.` : "⌥-drag the video in the preview to turn it in your hand.") font="-exact-caption1" color="-exact-tertiary-label" testId="angle-note"

                  column gap=10
                    button press=toggleSection("cursor") appearance="none" aria-expanded=openCursor testId="sec-cursor" padding-top=2 padding-bottom=2
                      row align-items="center" gap=6 flex=1
                        text "CURSOR" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6 flex=1 text-align="left"
                        image (openCursor ? "symbol:sf/chevron.down" : "symbol:sf/chevron.right") font="-exact-caption1" color="-exact-tertiary-label" aria-hidden=true
                    if openCursor
                      if summary.cursorDrawn
                        row align-items="center"
                          text "Show cursor" flex=1
                          input type="checkbox" switch checked=cursorOn change=setCursorOn aria-label="Show cursor" testId="cursor-on"
                        if cursorOn
                          column gap=4
                            row
                              text "Size" flex=1
                              text `${cursorSize}%` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                            input type="range" min=50 max=400 step=10 value=cursorSize input=setCursorSize aria-label="Cursor size" testId="cursor-size"
                          row align-items="center"
                            text "Squeeze on click" flex=1
                            input type="checkbox" switch checked=clickEffect change=setClickEffect aria-label="Squeeze on click" testId="click-effect"
                          row align-items="center"
                            text "Smooth movement" flex=1
                            input type="checkbox" switch checked=smoothCursor change=setSmoothCursor aria-label="Smooth movement" testId="smooth-cursor"
                      else
                        text "This recording has the system cursor in its picture. New recordings leave it out, so it can be hidden, resized and animated here." font="-exact-footnote" color="-exact-tertiary-label"

                  column gap=10
                    button press=toggleSection("device") appearance="none" aria-expanded=openDevice testId="sec-device" padding-top=2 padding-bottom=2
                      row align-items="center" gap=6 flex=1
                        text "DEVICE" font="-exact-caption1" font-weight=600 color="-exact-secondary-label" letter-spacing=0.6 flex=1 text-align="left"
                        image (openDevice ? "symbol:sf/chevron.down" : "symbol:sf/chevron.right") font="-exact-caption1" color="-exact-tertiary-label" aria-hidden=true
                    if openDevice
                      row gap=8
                        button press=editDo("find-device") buttonStyle="bordered" flex=1 testId="find-device"
                          image "symbol:sf/iphone"
                          text (summary.device ? "Fit to the Phone" : "Find a Device")
                        if isDevice
                          button popovertarget="crop-menu" buttonStyle="bordered" testId="crop"
                            image "symbol:sf/crop"
                            text "Crop"
                          column id="crop-menu" popover="auto" role="menu" aria-label="Crop"
                            button press=trim("top", 0.004) popovertarget="crop-menu" popovertargetaction="hide" testId="trim-top"
                              image "symbol:sf/arrow.down.to.line"
                              text "Trim Top"
                            button press=trim("bottom", 0.004) popovertarget="crop-menu" popovertargetaction="hide" testId="trim-bottom"
                              image "symbol:sf/arrow.up.to.line"
                              text "Trim Bottom"
                            button press=trim("left", 0.004) popovertarget="crop-menu" popovertargetaction="hide" testId="trim-left"
                              image "symbol:sf/arrow.right.to.line"
                              text "Trim Left"
                            button press=trim("right", 0.004) popovertarget="crop-menu" popovertargetaction="hide" testId="trim-right"
                              image "symbol:sf/arrow.left.to.line"
                              text "Trim Right"
                            hr
                            button press=trim("reset", 0) popovertarget="crop-menu" popovertargetaction="hide" testId="trim-reset"
                              image "symbol:sf/rectangle.expand.vertical"
                              text "Use the Whole Window"
                            if summary.found
                              button press=editDo("forget-device") popovertarget="crop-menu" popovertargetaction="hide" destructive=true testId="forget-device"
                                text "Not a Device"
                      text (isDevice ? "Cut to the phone’s own outline, side buttons included. Crop trims an edge a little at a time." : "Cuts the video to a phone’s own outline when the recording shows a Simulator in its window.") font="-exact-caption1" color="-exact-tertiary-label"

                  row gap=8
                    button press=editDo("clear") buttonStyle="bordered" flex=1 testId="clear"
                      text "Clear Edits"
                    button press=remove buttonStyle="bordered" flex=1 testId="delete"
                      text "Delete"
