#!/bin/bash
# exact-studio: the command-line tool for Exact Studio recordings (cli/main.swift).
# Builds it with the app's renderer sources when any of them is newer, then runs it.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bin="$here/.exact/cli/exact-studio"
sources=("$here/cli/main.swift" "$here/modules/apple/Compositor.swift" "$here/modules/apple/Scene3D.swift"
         "$here/modules/apple/Bezel.swift" "$here/modules/apple/Templates.swift" "$here/modules/apple/Images.swift")
stale=0
[ -x "$bin" ] || stale=1
for s in "${sources[@]}"; do [ "$s" -nt "$bin" ] && stale=1; done
if [ "$stale" = 1 ]; then
  mkdir -p "$(dirname "$bin")"
  echo "building exact-studio…" >&2
  swiftc -O -suppress-warnings -o "$bin" "${sources[@]}" >&2
fi
exec "$bin" "$@"
