{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exact-studio/edits.schema.json",
  "title": "Exact Studio edits.json",
  "description": "A recording's timeline. Every time is in seconds of the recording. See docs/edits.md.",
  "type": "object",
  "properties": {
    "splits": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Where the clip is cut, sorted"
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "The start of each clip part left out (0 or a split)"
    },
    "transitions": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "crossfade",
          "fade"
        ]
      },
      "description": "Keyed by the end of a kept part, in milliseconds"
    },
    "lanes": {
      "type": "integer",
      "minimum": 1,
      "description": "How many effect lanes the video has: they hold zoom, speed, spotlight, highlight, 3d, and a blur or mono with no scope"
    },
    "textLanes": {
      "type": "integer",
      "minimum": 0,
      "description": "How many text lanes there are; a text's lane counts these. A file without it is an old one, and the app sorts its texts into text lanes"
    },
    "frameLanes": {
      "type": "integer",
      "minimum": 0,
      "description": "How many whole-frame lanes there are: they hold a blur or mono with scope frame or all"
    },
    "base": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "description": "Centre, 0–1 of the frame's width"
        },
        "y": {
          "type": "number",
          "description": "Centre, 0–1 of the frame's height, from the top"
        },
        "scale": {
          "type": "number",
          "description": "1 fills the frame inside the padding"
        }
      },
      "additionalProperties": false
    },
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "t": {
            "type": "number",
            "description": "Seconds of the recording it lands at"
          },
          "to": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Centre, 0–1 of the frame's width"
              },
              "y": {
                "type": "number",
                "description": "Centre, 0–1 of the frame's height, from the top"
              },
              "scale": {
                "type": "number",
                "description": "1 fills the frame inside the padding"
              }
            },
            "additionalProperties": false
          },
          "style": {
            "enum": [
              "smooth",
              "linear",
              "spring",
              "zoom",
              "swipe",
              "fade",
              "spin",
              "pop"
            ]
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Seconds it travels before t"
          },
          "angles": {
            "type": "object",
            "properties": {
              "tilt": {
                "type": "number"
              },
              "turn": {
                "type": "number"
              },
              "roll": {
                "type": "number"
              }
            },
            "additionalProperties": false,
            "description": "Degrees: tilt leans the top away, turn swings the right side away, roll turns it flat."
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "t",
          "to"
        ]
      }
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The recorded sound's volume; 0 mutes it. It follows every cut, speed change and fade."
    },
    "soundLanes": {
      "type": "integer",
      "minimum": 0,
      "description": "How many sound lanes there are; a sound's lane counts these"
    },
    "sounds": {
      "type": "array",
      "description": "Music and sounds played over the video. A sound is not cut or sped up by the video's cuts and speed changes: it starts at the moment of the recording `start` names (the next kept moment, if that is removed) and plays straight through for `length` seconds, or until the video ends.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique among the sounds, and without a colon"
          },
          "file": {
            "type": "string",
            "description": "A path inside the recording's folder, in sounds/: M4A, MP3, WAV, AIFF, AAC or CAF"
          },
          "lane": {
            "type": "integer",
            "minimum": 0,
            "description": "Its sound lane; two sounds on one lane never play at once"
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "When it begins, in seconds of the recording"
          },
          "length": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "How many seconds of the file play"
          },
          "offset": {
            "type": "number",
            "minimum": 0,
            "description": "Where in the file it starts, in seconds; offset + length must fit in the file"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fadeIn": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds"
          },
          "fadeOut": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds"
          }
        },
        "required": [
          "id",
          "file",
          "start",
          "length"
        ],
        "additionalProperties": false
      }
    },
    "three": {
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        },
        "tilt": {
          "type": "number"
        },
        "turn": {
          "type": "number"
        },
        "roll": {
          "type": "number"
        },
        "thickness": {
          "type": "number",
          "description": "A share of the width"
        },
        "edge": {
          "enum": [
            "metal",
            "aluminum",
            "glass",
            "matte"
          ]
        }
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique, and without a colon"
          },
          "kind": {
            "enum": [
              "zoom",
              "speed",
              "text",
              "image",
              "3d",
              "spotlight",
              "highlight",
              "blur",
              "mono"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds of the recording"
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds of the recording; at least 0.1 after start"
          },
          "lane": {
            "type": "integer",
            "minimum": 0,
            "description": "Its row among its own kind: an effect lane, a text lane, a whole-frame lane, or for an image its place among the images (0 in front)"
          },
          "level": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "zoom: above 1 in, below 1 out"
          },
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "speed: 0.5 is half speed"
          },
          "scope": {
            "enum": [
              "video",
              "frame",
              "all"
            ],
            "description": "blur, mono: only the video (the default); the whole frame with its images, under the texts, which stay sharp; or all, the texts too"
          },
          "tilt": {
            "type": "number"
          },
          "turn": {
            "type": "number"
          },
          "roll": {
            "type": "number"
          },
          "style": {
            "type": "string",
            "description": "text: plain, pill, box, outline, shadow; 3d: hold, orbit"
          },
          "text": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "description": "text, image: centre, 0–1 of the frame's width"
          },
          "y": {
            "type": "number",
            "description": "text, image: centre, 0–1 of the frame's height, from the top"
          },
          "size": {
            "type": "number",
            "description": "text, image: height as a share of the frame's"
          },
          "color": {
            "enum": [
              "white",
              "black",
              "yellow",
              "pink",
              "blue",
              "mint"
            ]
          },
          "weight": {
            "enum": [
              "regular",
              "bold",
              "heavy",
              "rounded"
            ]
          },
          "animIn": {
            "enum": [
              "letters",
              "letters-pop",
              "drop",
              "typewriter",
              "pop",
              "spin",
              "slide",
              "rise",
              "blur",
              "fade",
              "none"
            ],
            "description": "text: any of these. image: pop, fade, rise, slide, spin, blur, none"
          },
          "animOut": {
            "enum": [
              "fade",
              "fall",
              "letters",
              "pop",
              "sink",
              "blur",
              "none"
            ],
            "description": "text: any of these. image: fade, pop, sink, blur, none"
          },
          "loop": {
            "enum": [
              "none",
              "wave",
              "pulse",
              "float",
              "wiggle"
            ]
          },
          "rotation": {
            "type": "number",
            "description": "text, image: degrees"
          },
          "file": {
            "type": "string",
            "description": "image: the picture, a path inside the recording's folder such as images/logo.png. `exact-studio image` copies a picture there"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "image"
          },
          "radius": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5,
            "description": "image: rounded corners, as a share of its shorter side"
          },
          "shadow": {
            "type": "boolean",
            "description": "image"
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "t": {
                  "type": "number",
                  "description": "Seconds of the recording it lands at"
                },
                "to": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "description": "Centre, 0–1 of the frame's width"
                    },
                    "y": {
                      "type": "number",
                      "description": "Centre, 0–1 of the frame's height, from the top"
                    },
                    "scale": {
                      "type": "number",
                      "description": "Multiplies the image's size: 1 keeps it"
                    }
                  },
                  "additionalProperties": false
                },
                "style": {
                  "enum": [
                    "smooth",
                    "linear",
                    "spring",
                    "zoom",
                    "swipe",
                    "fade",
                    "spin",
                    "pop"
                  ]
                },
                "duration": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Seconds it travels before t"
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "t",
                "to"
              ]
            },
            "description": "image: its own moves. Each lands inside the image's span"
          },
          "effects": {
            "type": "array",
            "description": "image: its own effects, each inside the image's span",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "blur",
                    "mono",
                    "fade",
                    "pulse",
                    "float",
                    "wiggle"
                  ]
                },
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Seconds of the recording"
                },
                "end": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Seconds of the recording; at least 0.1 after start"
                },
                "lane": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Its row under the image"
                },
                "level": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "fade: the opacity it fades to"
                }
              },
              "required": [
                "id",
                "kind",
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "start",
          "end"
        ]
      }
    }
  },
  "additionalProperties": false
}