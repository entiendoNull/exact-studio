size 1440x900

test "a recording opens with its preview, timeline, inspector and look"
  tap "recording-full"
  clock data
  expect tree has "preview"
  expect tree has "timeline"
  expect tree has "inspector"
  expect tree missing "empty"
  expect text "length" == "Video 0:09 · recorded 0:10"
  expect state summary.parts == 4
  expect state summary.removed == 1
  expect state summary.effects == 10
  expect state summary.lanes == 7
  expect state summary.moves == 1
  expect state background == "custom"
  expect state aspect == "9:16"

test "an empty recording has one clip part and nothing on it"
  tap "recording-empty"
  clock data
  expect text "length" == "Video 0:10 · recorded 0:10"
  expect state summary.parts == 1
  expect state summary.removed == 0
  expect state summary.effects == 0
  expect state summary.lanes == 0
  expect state summary.moves == 0

test "a click on a zoom selects it; the inspector sets its level and deletes it"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 286 162 mouse
  clock data
  expect text "segment-title" == "Zoom In"
  expect text "start" == "0:01.00"
  expect text "end" == "0:02.50"
  tap "level-3"
  clock data
  expect state sel.level == 3
  tap "segment-delete"
  clock data
  expect tree missing "segment"
  expect state summary.parts == 4
  expect state summary.removed == 1
  expect state summary.effects == 9
  expect state summary.lanes == 7
  expect state summary.moves == 1

test "a typed time that clashes says why under its field; Return refuses it and the field goes back"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 286 162 mouse
  clock data
  expect text "segment-title" == "Zoom In"
  type "end" "5.5"
  clock data
  expect text "end-why" == "One zoom at a time. Zoom out 0.7× starts at 0:05.0. End it by 0:05.0."
  expect state sel.end == 2.5
  type "end" key "Enter"
  clock data
  expect tree missing "end-why"
  expect text "end" == "0:02.50"
  expect state sel.end == 2.5
  expect state sel.problem == "One zoom at a time. Zoom out 0.7× starts at 0:05.0. End it by 0:05.0."

test "a click on a mask selects it and shows its style"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 233 198 mouse
  clock data
  expect text "segment-title" == "Mask"
  expect state sel.style == "solid"
  tap "mask-pixels"
  clock data
  expect state sel.style == "pixels"

test "a clip part is removed and put back from the inspector"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 233 77 mouse
  clock data
  expect text "segment-title" == "Clip Part"
  expect state sel.transition == "crossfade"
  tap "piece-remove"
  clock data
  expect state summary.removed == 2
  expect state sel.removed == true
  tap "piece-remove"
  clock data
  expect state summary.removed == 1

test "Split Clip with the playhead at the start is off and says why"
  tap "recording-empty"
  clock data
  expect disabled "split-clip"
  expect state summary.splitWhy == "Move the playhead into the clip to split it."
  expect state summary.parts == 1
  expect state summary.removed == 0
  expect state summary.effects == 0
  expect state summary.lanes == 0
  expect state summary.moves == 0

test "Split follows the selection; Split All Lanes is off at the start and says why"
  tap "recording-full"
  clock settle
  expect state summary.splitLabel == "Split Clip"
  expect disabled "split-all"
  expect state summary.splitAllWhy == "Nothing under the playhead can be split there."
  tap "timeline" drag 0 0 from 286 162 mouse
  clock data
  expect state summary.splitLabel == "Split Zoom"
  expect state summary.canSplit == false
  expect disabled "split-clip"

test "Split Text splits the selected text at the playhead, as one undo step"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 286 12 mouse
  clock data
  tap "timeline" drag 0 0 from 271 306 mouse
  clock data
  expect state summary.splitLabel == "Split Text"
  expect state summary.canSplit == true
  tap "split-clip"
  clock data
  expect state summary.undoName == "Split Text"
  expect state summary.effects == 11
  expect state summary.parts == 4

test "a template replaces the edit; Undo and Redo take it back and forth"
  tap "recording-full"
  clock data
  expect disabled "undo"
  tap "templates"
  expect tree has "template-clean"
  expect tree has "template-hero"
  expect tree has "template-before-after"
  expect tree has "template-spotlight"
  expect tree has "template-social"
  expect tree has "template-launch"
  tap "template-steps"
  clock data
  expect state summary.undoName == "Template"
  tap "undo"
  clock data
  expect state summary.parts == 4
  expect state summary.removed == 1
  expect state summary.effects == 10
  expect state summary.lanes == 7
  expect state summary.moves == 1
  expect state summary.redoName == "Template"
  tap "redo"
  clock data
  expect state summary.undoName == "Template"
  expect state summary.redoName == ""

test "⌘Z undoes and ⇧⌘Z and ⌘Y redo; a slider scrub is one step"
  tap "recording-empty"
  clock data
  type "padding" "12"
  type "padding" "16"
  type "padding" "20"
  clock data
  expect state padding == 20
  expect state summary.undoName == "Padding"
  type "root" key "Meta+z"
  clock data
  expect state padding == 8
  type "root" key "Meta+Shift+z"
  clock data
  expect state padding == 20
  type "root" key "Meta+z"
  type "root" key "Meta+y"
  clock data
  expect state padding == 20

test "while a text field has the focus, ⌘Z is the field's"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 271 306 mouse
  clock data
  tap "text-words"
  expect state typing == true
  type "text-words" key "Meta+z"
  clock data
  expect state summary.undoName == ""
  expect state sel.text == "Hello"

test "Clear Edits asks first, names the recording, and can be undone"
  tap "recording-full"
  clock data
  tap "inspector-more"
  tap "clear"
  clock settle
  tap "clear-cancel"
  clock settle
  expect state summary.parts == 4
  expect state summary.removed == 1
  expect state summary.effects == 10
  expect state summary.lanes == 7
  expect state summary.moves == 1
  tap "inspector-more"
  tap "clear"
  clock settle
  tap "clear-confirm"
  clock settle
  clock data
  expect state summary.parts == 1
  expect state summary.removed == 0
  expect state summary.effects == 0
  expect state summary.lanes == 0
  expect state summary.moves == 0
  expect state summary.undoName == "Clear Edits"
  tap "undo"
  clock data
  expect state summary.parts == 4
  expect state summary.removed == 1
  expect state summary.effects == 10
  expect state summary.lanes == 7
  expect state summary.moves == 1

test "Delete asks first and names the recording; Cancel keeps it"
  tap "recording-empty"
  clock data
  tap "inspector-more"
  tap "delete"
  clock settle
  expect state removingName == "Empty window"
  tap "delete-cancel"
  clock settle
  clock data
  expect tree has "recording-empty"
  tap "inspector-more"
  tap "delete"
  clock settle
  tap "delete-confirm"
  clock settle
  clock data
  expect tree missing "recording-empty"
  expect state selected == ""

test "the floating settings panel stays on the stage"
  tap "recording-full"
  clock settle
  tap "inspector-more"
  tap "panel-menu-button"
  tap "menu-panel-float"
  clock settle
  tap "timeline" drag 0 0 from 271 306 mouse
  clock data
  expect tree has "float-panel"
  expect text "segment-title" == "Text"
  tap "float-grip" drag 950 820
  clock data
  expect state floatX <= 460
  expect state floatY <= 160
  expect state floatClear == true

test "the inspector's sections fold, and the look's controls change look.json"
  tap "recording-empty"
  clock data
  expect tree has "bg-ocean"
  tap "bg-sunset"
  clock data
  expect state background == "sunset"
  tap "aspect-1:1"
  clock data
  expect state aspect == "1:1"
  tap "sec-bg"
  expect tree missing "bg-ocean"
  tap "sec-bg"
  expect tree has "bg-ocean"
  tap "sec-frame"
  expect tree missing "aspect-1:1"

test "a click on a text selects it; its words show in the inspector"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 271 306 mouse
  clock data
  expect text "segment-title" == "Text"
  expect state sel.text == "Hello"
  expect state sel.style == "pill"

test "Motion Paths is on by default, turns off, and stays off after a relaunch"
  tap "recording-full"
  clock data
  expect state showMotionPaths == true
  tap "motion-paths"
  clock data
  expect state showMotionPaths == false
  reload
  clock data
  expect state showMotionPaths == false
  tap "recording-full"
  clock data
  tap "motion-paths"
  expect state showMotionPaths == true

test "the inspector is calm: nothing selected shows the Frame, with no help text"
  tap "recording-full"
  clock data
  expect text "inspector-title" == "Frame"
  expect tree has "inspector-hint"
  expect tree missing "sec-help"
  expect tree has "sec-bg"

test "a recording is deleted from its Library row's right-click menu, after asking"
  tap "recording-empty" contextmenu
  tap "library-delete"
  clock settle
  expect state removingName == "Empty window"
  tap "delete-confirm"
  clock settle
  clock data
  expect tree missing "recording-empty"

test "each area has its own bar: the toolbar the piece, the viewer bar the video, the timeline bar the timeline"
  tap "recording-full"
  clock data
  expect tree has "templates"
  expect tree has "export-open"
  expect text "video-scope" == "VIDEO"
  expect tree has "crop-open"
  expect tree has "clock"
  expect tree has "motion-paths"
  expect tree has "split-clip"
  expect disabled "split-all"
  expect tree has "zoom-controls"
  expect tree missing "sec-place"

test "Place on the viewer bar places the video"
  tap "recording-empty"
  clock data
  tap "place-open"
  tap "place-left"
  clock data
  expect state summary.undoName == "Placement"

test "the floating settings panel never covers the timeline, however low it is dropped"
  tap "recording-full"
  clock settle
  tap "inspector-more"
  tap "panel-menu-button"
  tap "menu-panel-float"
  clock settle
  tap "timeline" drag 0 0 from 271 306 mouse
  clock data
  expect tree has "float-panel"
  tap "float-grip" drag 0 840
  clock data
  expect state floatClear == true
  expect state floatH >= 100

test "the rows sit under the Clip with no group headers: a click on the Clip, then on a text, selects each"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 233 77 mouse
  clock data
  expect text "segment-title" == "Clip Part"
  tap "timeline" drag 0 0 from 271 306 mouse
  clock data
  expect text "segment-title" == "Text"
  expect state sel.text == "Hello"

test "a blur's Applies To stack: a click on a layer, the dragged line and Video Only set its reach"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 735 270 mouse
  clock data
  expect text "segment-title" == "Blur"
  expect state sel.scope == "frame"
  expect text "reach-word-0" == "sharp"
  expect text "reach-word-1" == "blurred"
  expect text "reach-line-label" == "Blur"
  tap "reach-row-2"
  clock data
  expect state sel.scope == "scene"
  expect text "reach-word-1" == "sharp"
  expect text "reach-word-3" == "blurred"
  tap "reach-line" drag 0 -40
  clock data
  expect state sel.scope == "frame"
  tap "scope-video"
  clock data
  expect state sel.scope == "video"
  expect tree missing "reach-line"
  expect text "reach-word-2" == "blurred"
  expect text "reach-word-3" == "sharp"
  tap "scope-line"
  clock data
  expect state sel.scope == "scene"

test "a text gets a blur and a black and white of its own from its inspector"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 271 306 mouse
  clock data
  expect text "segment-title" == "Text"
  tap "text-fx-blur"
  clock data
  expect state sel.kind == "ifx"
  expect state sel.fx == "blur"
  expect state sel.file == "“Hello”"
  expect text "segment-title" == "Text Effect"

test "a text's Depth stack sends it behind the video and back; the ⋯ arrange command is one undo step"
  tap "recording-full"
  clock settle
  tap "timeline" drag 0 0 from 271 306 mouse
  clock data
  expect text "segment-title" == "Text"
  expect state sel.layer == "front"
  expect text "depth-line-label" == "This text"
  tap "depth-row-3"
  clock data
  expect state sel.layer == "behind"
  expect state summary.undoName == "Send Behind Video"
  tap "depth-line" drag 0 -80
  clock data
  expect state sel.layer == "front"
  expect state summary.undoName == "Bring In Front of Video"
  tap "panel-place-button"
  clock settle
  tap "arrange-video"
  clock data
  expect state sel.layer == "behind"
  tap "undo"
  clock data
  expect state sel.layer == "front"
  expect disabled "menu-arrange-in-front"
  expect enabled "menu-arrange-behind"

test "Export refuses unfilled lines and lists them; Show First focuses the first; once written it exports"
  tap "recording-full"
  clock data
  tap "templates"
  tap "template-social"
  clock data
  tap "export-open"
  clock data
  expect text "export-unfilled-title" == "1 line to fill first"
  expect text "export-unfilled-line" == "0:00.2 [Hook line]"
  expect tree missing "export"
  expect tree missing "export-copy"
  screenshot "/Users/jacobclausen/devroot/scratch/shots/export/export-refuses-unfilled.png"
  tap "export-close"
  tap "toggle-right"
  clock settle
  tap "export-open"
  clock data
  tap "export-show-first"
  clock data
  clock +1
  expect tree missing "export-lightbox"
  expect state rightOpen == true
  expect state sel.text == "[Hook line]"
  expect focused "text-words"
  type "text-words" "Framed in one click"
  type "text-words" key "Enter"
  clock data
  expect state check.count == 0
  tap "export-open"
  clock data
  expect tree missing "export-unfilled"
  tap "export"
  clock until state exportLine == "Saved." within 60000
  expect text "export-line" == "Saved."

test "View › Show Empty Lanes is a view setting, off by default"
  tap "recording-empty"
  clock data
  expect state summary.lanes == 0
  expect state summary.showEmptyLanes == false
  expect tree has "menu-empty-lanes"
