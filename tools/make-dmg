#!/bin/bash
# make-dmg: build the release app and pack it in a disk image, with no Apple Developer account.
# The app in the image is ad-hoc signed and not notarised, so macOS asks the person who
# downloads it to allow it once (README, Install).
#
#   tools/make-dmg [<version>]     writes dist/Exact-Studio-<version>.dmg
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$here"
version="${1:-0.0.0-dev}"
version="${version#v}"

built="$(bun exact.mjs mac --release --json | tail -1)"
app="$(printf '%s' "$built" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])')"
[ -d "$app" ] || { echo "make-dmg: the build left no app at $app" >&2; exit 1; }

out="$here/dist"
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
/usr/bin/ditto "$app" "$stage/Exact Studio.app"
staged="$stage/Exact Studio.app"

/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $version" "$staged/Contents/Info.plist"
# One ad-hoc signature whoever built it: a local build carries the builder's own
# development certificate, which means nothing on another Mac.
codesign --force --sign - "$staged/Contents/MacOS/libexact_modules.dylib"
codesign --force --sign - "$staged"
codesign --verify --strict "$staged"

ln -s /Applications "$stage/Applications"
mkdir -p "$out"
dmg="$out/Exact-Studio-$version.dmg"
hdiutil create -volname "Exact Studio" -srcfolder "$stage" -ov -format UDZO -quiet "$dmg"
echo "$dmg"
